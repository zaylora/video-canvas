FROM golang:1.27-bookworm

WORKDIR /app

# 先缓存模块下载；Compose 运行时会把 backend 源码挂载到 /app。
COPY go.mod go.sum ./
RUN go mod download && go install github.com/air-verse/air@latest

# 画布 Agent 看视频、截帧需要 ffmpeg / ffprobe；安装后清理软件包索引以缩小镜像。
RUN apt-get update && apt-get install -y --no-install-recommends ffmpeg && rm -rf /var/lib/apt/lists/*

# 画布 Agent 运行时需要 node（agent.enabled=true 时才用）；依赖在宿主机的仓库根目录 agent/ 里 npm ci，agent/ 整个目录挂载到容器的 /agent（见 docker-compose.dev.yml）
COPY --from=node:22-bookworm-slim /usr/local/bin/node /usr/local/bin/node

ENV CGO_ENABLED=0 \
    GOFLAGS=-buildvcs=false

EXPOSE 8080
