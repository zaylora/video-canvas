[
  {
    "name": "canvas_get_state",
    "description": "读画布。不传参数返回目录（每个节点的 id、种类、标题、所属组、是否已有产物、提示词摘要，选中的节点排在最前）；传 nodeIds 或 groupId 返回节点的完整数据和连线。需要节点的完整提示词和参数时用它，不要猜。详情里的 mode 是图片、视频节点当前的生成方式：op 为空表示没选（生成时有参考图且模型支持图生就走图生，否则取 options 里的第一个），options 是该模型可选的方式，auto 为真表示按有没有参考图自动判断、不用设置。",
    "parameters": {
      "type": "object",
      "properties": {
        "nodeIds": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "要读的节点，最多 50 个"
        },
        "groupId": {
          "type": "string",
          "description": "读这个组的全部成员"
        }
      }
    }
  },
  {
    "name": "canvas_apply_ops",
    "description": "对画布做一批编辑，一次最多 30 项，整批要么全部生效要么都不生效（失败时会列出每一项的问题）。可以新建节点和组、改标题提示词模型参数、连线、移动、增减组成员。修改已有节点的内容或参数前，须先调用 canvas_get_state 读取其详情（传 nodeIds 或 groupId）；本轮自建节点可直接修改。修改组名或颜色须用 nodeIds 读取组本身。产物字段（图片、视频地址）不能写；已有产物的重做请新建节点。连线规则：文本→全部；图片→图片/视频/音频；视频→视频；音频→视频。提示词里要用已连线的素材时写 @[素材名](节点id)（节点id 必须是真实 id，且该节点已连线到本节点），提交生成时会展开成素材编号，不要手写“图1”“图2”；本批新建的节点没有真实 id，要引用就先建好再用 update_node 写提示词。视频节点要用 mode 选对生成方式（文生 / 图生 / 全能参考），方式和已连的参考素材对不上时，结果里的 warnings 会提醒，按提醒改正。",
    "parameters": {
      "type": "object",
      "required": [
        "ops"
      ],
      "properties": {
        "ops": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "op"
            ],
            "properties": {
              "op": {
                "anyOf": [
                  {
                    "type": "string",
                    "const": "create_node"
                  },
                  {
                    "type": "string",
                    "const": "update_node"
                  },
                  {
                    "type": "string",
                    "const": "create_group"
                  },
                  {
                    "type": "string",
                    "const": "set_group"
                  },
                  {
                    "type": "string",
                    "const": "connect"
                  },
                  {
                    "type": "string",
                    "const": "move"
                  }
                ],
                "description": "操作种类"
              },
              "tempId": {
                "type": "string",
                "description": "新建时的临时 id，同一次调用里的后续操作可以用它引用新建的对象"
              },
              "id": {
                "type": "string",
                "description": "目标节点或组的 id（update_node / set_group / move），也可以是前面操作的 tempId"
              },
              "kind": {
                "anyOf": [
                  {
                    "type": "string",
                    "const": "script"
                  },
                  {
                    "type": "string",
                    "const": "image"
                  },
                  {
                    "type": "string",
                    "const": "video"
                  },
                  {
                    "type": "string",
                    "const": "audio"
                  }
                ],
                "description": "create_node：节点种类，script 是文本"
              },
              "label": {
                "type": "string",
                "description": "标题，最多 40 字"
              },
              "prompt": {
                "type": "string",
                "description": "提示词"
              },
              "model": {
                "type": "string",
                "description": "生成模型 key，来自 model_list"
              },
              "mode": {
                "type": "string",
                "enum": [
                  "t2v",
                  "i2v",
                  "omni",
                  "t2i",
                  "i2i"
                ],
                "description": "生成方式，对应节点生成面板顶部的页签。视频节点：t2v 文生视频（只靠提示词，不引用参考素材）、i2v 图生视频（只引用连进来的图片）、omni 全能参考（可同时引用图片、视频、音频）。需要先有 model，可选值以 model_list 里该模型的 ops 为准，不支持的会报错。同时支持文生图和图生图的图片模型按有没有参考图自动判断，不用也不能设置。新建视频节点时按它要用的素材选：只有文字用 t2v，连了角色图或首帧用 i2v，还要连视频或音频参考用 omni。"
              },
              "params": {
                "type": "object",
                "patternProperties": {
                  "^.*$": {}
                },
                "description": "生成参数，按模型的参数名"
              },
              "parentGroup": {
                "type": "string",
                "description": "create_node：放进这个组（id 或 tempId）"
              },
              "position": {
                "type": "object",
                "required": [
                  "x",
                  "y"
                ],
                "properties": {
                  "x": {
                    "type": "number"
                  },
                  "y": {
                    "type": "number"
                  }
                }
              },
              "color": {
                "type": "string",
                "description": "组背景色：red/orange/yellow/green/cyan/blue/purple/pink，空串清除"
              },
              "labelColor": {
                "type": "string",
                "description": "组名颜色，取值同 color"
              },
              "memberIds": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "create_group：初始成员"
              },
              "addMembers": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "set_group：加入的成员"
              },
              "removeMembers": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "set_group：移出的成员"
              },
              "source": {
                "type": "string",
                "description": "connect：起点节点"
              },
              "target": {
                "type": "string",
                "description": "connect：终点节点"
              }
            },
            "additionalProperties": false
          },
          "description": "操作列表"
        }
      }
    }
  },
  {
    "name": "canvas_arrange",
    "description": "整理布局：把一个组的成员或一组节点排成一行、一列或网格。只排列节点或组内成员，不会移动组本身；要挪组用 canvas_apply_ops 的 move。",
    "parameters": {
      "type": "object",
      "required": [
        "layout"
      ],
      "properties": {
        "groupId": {
          "type": "string",
          "description": "排列这个组的成员，排完后组框自动贴合"
        },
        "nodeIds": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "排列这些节点"
        },
        "layout": {
          "anyOf": [
            {
              "type": "string",
              "const": "row"
            },
            {
              "type": "string",
              "const": "column"
            },
            {
              "type": "string",
              "const": "grid"
            }
          ],
          "description": "row 横排 / column 竖排 / grid 网格"
        }
      }
    }
  },
  {
    "name": "canvas_delete",
    "description": "申请删除节点或连线。不会直接删除：会向用户展示确认卡片，本轮暂停，用户决定后你会收到结果。只在用户明确要求清理或你确信是废稿时使用。",
    "parameters": {
      "type": "object",
      "required": [
        "reason"
      ],
      "properties": {
        "nodeIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "edgeIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "reason": {
          "type": "string",
          "description": "给用户看的理由"
        }
      }
    }
  },
  {
    "name": "plan_update",
    "description": "展示和更新你的执行计划（最多 12 步）。开始较长的任务前先列计划，每完成一步更新状态。",
    "parameters": {
      "type": "object",
      "required": [
        "steps"
      ],
      "properties": {
        "steps": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "title",
              "status"
            ],
            "properties": {
              "title": {
                "type": "string",
                "description": "这一步做什么，80 字以内"
              },
              "status": {
                "anyOf": [
                  {
                    "type": "string",
                    "const": "todo"
                  },
                  {
                    "type": "string",
                    "const": "doing"
                  },
                  {
                    "type": "string",
                    "const": "done"
                  }
                ]
              }
            }
          }
        }
      }
    }
  },
  {
    "name": "ask_user",
    "description": "信息不够时向用户提问，而不是猜。kind=choice 给 2 到 4 个选项；kind=model 让用户从已发布的图片或视频模型里选一个。提问后本轮暂停，用户回答后你会收到结果。",
    "parameters": {
      "type": "object",
      "required": [
        "question",
        "kind"
      ],
      "properties": {
        "question": {
          "type": "string"
        },
        "kind": {
          "anyOf": [
            {
              "type": "string",
              "const": "choice"
            },
            {
              "type": "string",
              "const": "model"
            }
          ]
        },
        "options": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "kind=choice 的选项"
        },
        "modelKind": {
          "anyOf": [
            {
              "type": "string",
              "const": "image"
            },
            {
              "type": "string",
              "const": "video"
            }
          ],
          "description": "kind=model 时选哪类模型"
        },
        "allowCustom": {
          "type": "boolean",
          "description": "是否允许用户自己输入答案"
        }
      }
    }
  },
  {
    "name": "model_list",
    "description": "列出已发布的生成模型（图片、视频或音频）及其能力和价格摘要：支持的生成方式、参考素材、参数和可选值。建节点前用它挑模型、写对参数。",
    "parameters": {
      "type": "object",
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "anyOf": [
            {
              "type": "string",
              "const": "image"
            },
            {
              "type": "string",
              "const": "video"
            },
            {
              "type": "string",
              "const": "audio"
            }
          ]
        }
      }
    }
  },
  {
    "name": "generate_media",
    "description": "为画布上的节点申请生成（图片、视频、音频、文本）。不会直接生成：会向用户展示确认卡片（含预估积分），本轮暂停，用户批准后任务才创建，你会收到结果。节点必须已选好模型、写好提示词，且还没有产物（不会覆盖已有产物，需要新版本请先新建节点）。上游连线的文字和素材会自动作为提示词补充和参考。一个节点只生成一个结果，要多个结果请建多个节点。",
    "parameters": {
      "type": "object",
      "required": [
        "items"
      ],
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "nodeId"
            ],
            "properties": {
              "nodeId": {
                "type": "string"
              }
            }
          },
          "description": "要生成的节点，最多 8 个"
        },
        "reason": {
          "type": "string",
          "description": "给用户看的说明"
        }
      }
    }
  },
  {
    "name": "task_get",
    "description": "查询一个生成任务的状态、进度、失败原因和产物。taskId 是节点数据里记录的任务 id，或批准生成后结果里的 task_id。",
    "parameters": {
      "type": "object",
      "required": [
        "taskId"
      ],
      "properties": {
        "taskId": {
          "type": "string"
        }
      }
    }
  },
  {
    "name": "skill_search",
    "description": "在技能库（管理员导入的技能）里按关键词找方法说明。不传关键词列出前几个。",
    "parameters": {
      "type": "object",
      "properties": {
        "query": {
          "type": "string",
          "description": "关键词，空格分隔"
        }
      }
    }
  },
  {
    "name": "skill_read",
    "description": "读一个技能的完整方法说明；技能带资源文件时，正文末尾会列出清单，再传 file 读其中的文本文件。用户消息里的 @[名字](skill:key) 就是在指定要用的技能，key 即技能名。系统提示词里有「可用技能」目录时，做相关的事之前先读对应技能。",
    "parameters": {
      "type": "object",
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string",
          "description": "技能名，取自「可用技能」目录或 skill_search 的结果"
        },
        "file": {
          "type": "string",
          "description": "技能包内的文件路径（相对技能根目录，取自正文末尾的资源清单），不传读正文"
        }
      }
    }
  },
  {
    "name": "canvas_inspect_image",
    "description": "查看图片节点当前的图片内容（最多 4 张）。标题和提示词不等于画面：判断画面是否符合要求、人物是否一致、要不要重做之前，先看图。只能看已经有图片的图片节点。",
    "parameters": {
      "type": "object",
      "required": [
        "nodeIds"
      ],
      "properties": {
        "nodeIds": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "图片节点 id，1 到 4 个"
        }
      }
    }
  }
]
