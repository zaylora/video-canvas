{
  "key": "kling-i2v",
  "kind": "video",
  "label": "可灵 图生视频",
  "hint": "5 秒或 10 秒，支持首帧",
  "deadline": "30m",
  "enabled": true,
  "sort": 100,

  "channels": [
    { "channel": "newapi-main", "upstream_model": "kling-v2-master" }
  ],

  "params": { "max_tokens": 2000, "instanceType": "default" },

  "capabilities": {
    "ops": ["t2v", "i2v", "omni"],
    "refs": {
      "image": { "on": true, "max": 4, "max_mb": 10 },
      "audio": { "on": true, "max": 1, "max_mb": 15 },
      "video": { "on": false, "max": 0, "max_mb": 0 }
    },
    "prompt": { "max_length": 2000 },
    "params": {
      "aspect_ratio": { "type": "enum", "label": "比例", "open": true, "options": ["Auto", "16:9", "9:16"], "default": "Auto" },
      "resolution": { "type": "enum", "label": "清晰度", "open": true, "options": ["720P", "1080P"], "default": "720P", "spec": true },
      "duration": { "type": "number", "label": "视频时长", "open": true, "min": 4, "max": 12, "step": 1, "default": 5, "unit": "秒" },
      "generate_audio": { "type": "boolean", "label": "生成音频", "open": true, "default": true, "spec": true }
    }
  },

  "pricing": {
    "billing": "per_second",
    "per_second": 2,
    "tiers": [
      { "on": true, "when": { "resolution": "1080P" }, "unit": 4 },
      { "on": true, "when": { "resolution": "1080P", "generate_audio": true }, "unit": 5 },
      { "on": true, "when": { "op": "omni" }, "unit": 3 }
    ],
    "cost": { "on": true, "per_second": 1 }
  }
}
