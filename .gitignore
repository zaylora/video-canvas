# 根目录运行时配置
.env

# 后端构建产物与运行时数据
/backend/bin/
/backend/tmp/
/backend/**/*.exe
/backend/data/
/backend/logs/
/backend/configs/*.local.yaml

# Agent 运行时（Node）依赖
/agent/node_modules/

# 前端依赖与构建产物
/web/node_modules/
/web/dist/

# IDE
/.idea/
/.vscode/
/backend/.idea/
/backend/.vscode/
/web/.idea/
/web/.vscode/

# Agent 调优 Harness 的运行输出与线上导出的轨迹包（含用户数据，不入库）
/.harness/

# Agent 调优 Harness：to-case 从线上轨迹包生成的用例与初始画布（含用户的剧本和提示词，不入库；要提交请先脱敏并改放到 cases/、fixtures/）
/agent/harness/cases-imported/
/agent/harness/fixtures/imported/
