{
  "name": "video-canvas-agent-runtime",
  "private": true,
  "description": "画布 Agent 的独立 Pi 运行时：平台能力通过 Go 桥调用，联网通过独立 MCP 子进程执行",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "oxlint",
    "serve": "node --disable-warning=ExperimentalWarning src/serve.ts",
    "start": "node dist/serve.js",
    "test": "node --disable-warning=ExperimentalWarning --test \"test/*.test.ts\""
  },
  "dependencies": {
    "@earendil-works/chord": "1.4.0",
    "@earendil-works/pi-agent-core": "1.4.0",
    "@earendil-works/pi-ai": "1.4.0",
    "@earendil-works/pi-codemode": "1.4.0",
    "@earendil-works/pi-durable": "1.4.0",
    "@earendil-works/pi-telemetry": "1.4.0",
    "@modelcontextprotocol/sdk": "1.32.1",
    "fastify": "5.12.7",
    "pi-web-access": "0.46.0",
    "typebox": "1.3.27"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "oxfmt": "0.71.0",
    "oxlint": "1.86.0",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=22.19.0"
  }
}
