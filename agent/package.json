{
  "name": "video-canvas-agent-runtime",
  "private": true,
  "type": "module",
  "description": "画布 Agent 的运行时：在独立的 Node 进程里跑 pi 的 agent 循环；模型、工具、状态都通过桥回到 Go，进程里没有任何密钥",
  "engines": { "node": ">=22.19.0" },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "serve": "node --disable-warning=ExperimentalWarning src/serve.ts",
    "start": "node dist/serve.js",
    "test": "node --disable-warning=ExperimentalWarning --test \"test/*.test.ts\""
  },
  "dependencies": {
    "@earendil-works/chord": "1.4.0",
    "@earendil-works/pi-agent-core": "1.4.0",
    "@earendil-works/pi-ai": "1.4.0",
    "@earendil-works/pi-codemode": "1.4.0",
    "@earendil-works/pi-durable": "1.4.0",
    "@earendil-works/pi-telemetry": "1.4.0",
    "typebox": "1.3.27"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "typescript": "7.0.2"
  }
}
